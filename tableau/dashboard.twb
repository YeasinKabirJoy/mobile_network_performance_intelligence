      <aliases enabled='yes' />
      <column caption='Tile-Quarter Key' datatype='string' name='[Calculation_0338709608824832]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[quadkey] + &quot;|&quot; + [quarter_label]' />
      </column>
      <column caption='Tile Count' datatype='integer' name='[Calculation_0338709609476097]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([Calculation_0338709608824832])' />
      </column>
      <column caption='Test-Weighted Download Mbps' datatype='real' name='[Calculation_0338709609590786]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([avg_d_mbps] * [tests]) / SUM([tests])' />
      </column>
      <column caption='Test-Weighted Upload Mbps' datatype='real' name='[Calculation_0338709609672707]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([avg_u_mbps] * [tests]) / SUM([tests])' />
      </column>
      <column caption='Test-Weighted Idle Latency Ms' datatype='real' name='[Calculation_0338709609766916]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(&#13;&#10;    IF NOT ISNULL([avg_lat_ms])&#13;&#10;    THEN [avg_lat_ms] * [tests]&#13;&#10;    END&#13;&#10;)&#13;&#10;/&#13;&#10;SUM(&#13;&#10;    IF NOT ISNULL([avg_lat_ms])&#13;&#10;    THEN [tests]&#13;&#10;    END&#13;&#10;)' />
      </column>
      <column caption='Low-Volume Tile Percent' datatype='real' name='[Calculation_0338709609857029]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(&#13;&#10;    IF [measurement_volume] = &quot;low&quot;&#13;&#10;    THEN [Calculation_0338709608824832]&#13;&#10;    END&#13;&#10;)&#13;&#10;/&#13;&#10;COUNTD([Calculation_0338709608824832])' />
      </column>
      <column caption='Regional Priority Score' datatype='real' name='[Calculation_0338709609934854]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='MIN([base_score])' />
      </column>
      <column caption='Regional Priority Rank' datatype='integer' name='[Calculation_0338709610000391]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='MIN([base_rank])' />
      </column>
